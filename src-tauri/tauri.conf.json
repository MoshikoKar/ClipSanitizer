{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip Sanitizer",
  "version": "0.2.0",
  "identifier": "app.clipsanitizer",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Clip Sanitizer",
        "url": "index.html",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "toast",
        "title": "Clip Sanitizer",
        "url": "toast.html",
        "width": 360,
        "height": 84,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "shortDescription": "Sanitize selected text with a hotkey"
  }
}
